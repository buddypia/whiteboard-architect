# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=us-central1

# Gemini API (Google AI Studio)
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_MODEL_NAME=gemini-2.5-flash-native-audio-preview-09-2025

# Cloud Firestore (uses default credentials if running on GCP)
FIRESTORE_DATABASE=(default)

# Cloud Storage (leave empty for local dev; Terraform creates ${PROJECT_ID}-whiteboard-snapshots)
GCS_BUCKET_NAME=

# Backend
BACKEND_PORT=8080
BACKEND_HOST=0.0.0.0

# Background Whiteboard Analysis (Perception Layer)
ANALYSIS_ENABLED=true
ANALYSIS_INTERVAL_S=30
ANALYSIS_MODEL_NAME=gemini-3-flash-preview
# thinking_budget と thinking_level は排他（Gemini API 制約）。
# budget > 0 なら budget を使用。budget=0 かつ level 設定時のみ level を使用。
ANALYSIS_THINKING_BUDGET=2048
# ANALYSIS_THINKING_LEVEL=medium  # budget=0 の場合のみ有効
ANALYSIS_MEDIA_RESOLUTION=medium

# Frontend
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
