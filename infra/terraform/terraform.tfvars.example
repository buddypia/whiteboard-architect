project_id     = "your-gcp-project-id"
region         = "us-central1"
gemini_api_key = "your-gemini-api-key"
backend_image  = "us-central1-docker.pkg.dev/your-project/whiteboard-architect/backend:latest"
frontend_image = "us-central1-docker.pkg.dev/your-project/whiteboard-architect/frontend:latest"

